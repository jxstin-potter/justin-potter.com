# Emit every image as a real file instead of inlining small ones as base64.
#
# CRA inlines any asset under 10kB into the JS bundle by default. That is the
# wrong trade for this site: images are served through <picture> with AVIF,
# WebP and JPEG variants, and an inlined variant is downloaded as part of the
# bundle by every browser - including ones that cannot decode that format and
# will never display it. Small AVIF card images were adding ~10kB to the main
# chunk this way.
#
# As separate files they are fetched only when the browser picks that format,
# and they get their own long-lived cache entry.
IMAGE_INLINE_SIZE_LIMIT=0
